{
  "kind": "collectionType",
  "collectionName": "moments",
  "info": {
    "singularName": "moment",
    "pluralName": "moments",
    "displayName": "Moment",
    "description": "Thin derived index of meaningful artist–fan occurrences. Canonical domain rows remain truth. Do not store presentation copy or media."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "kind": {
      "type": "enumeration",
      "enum": [
        "show",
        "artist_update",
        "milestone",
        "release",
        "artist_growth",
        "city_growth",
        "fan_relationship",
        "support",
        "tour",
        "period_recap",
        "manual",
        "fan_memory"
      ],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["candidate", "published", "archived"],
      "required": true,
      "default": "candidate"
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "artist_fan",
        "artist_only",
        "fan_only",
        "show_attendees",
        "fan_list",
        "public"
      ],
      "required": true,
      "default": "artist_fan"
    },
    "band": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::band.band",
      "required": true
    },
    "subjectFan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::fan.fan"
    },
    "occurredAt": {
      "type": "datetime",
      "required": true
    },
    "createdByType": {
      "type": "enumeration",
      "enum": ["system", "artist_user", "fan_user"],
      "required": true,
      "default": "system"
    },
    "createdByUserId": {
      "type": "integer"
    },
    "sourceType": {
      "type": "string",
      "required": true
    },
    "sourceId": {
      "type": "string",
      "required": true
    },
    "idempotencyKey": {
      "type": "string",
      "required": true,
      "unique": true,
      "column": { "unique": true }
    },
    "shareable": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "publishedAt": {
      "type": "datetime"
    },
    "archivedAt": {
      "type": "datetime"
    },
    "schemaVersion": {
      "type": "integer",
      "required": true,
      "default": 1
    }
  }
}
