{
  "kind": "collectionType",
  "collectionName": "conversation_requests",
  "info": {
    "singularName": "conversation-request",
    "pluralName": "conversation-requests",
    "displayName": "Conversation Request",
    "description": "Fan-initiated message request gate before a direct conversation."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "requesterUser": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "requesterFan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::fan.fan",
      "required": true
    },
    "recipientBand": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::band.band",
      "required": true
    },
    "requesterType": {
      "type": "enumeration",
      "enum": ["fan", "band"],
      "default": "fan",
      "required": true
    },
    "initialMessage": {
      "type": "text",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "accepted", "declined"],
      "default": "pending",
      "required": true
    },
    "pairKey": {
      "type": "string",
      "required": true,
      "private": true,
      "searchable": false
    },
    "pendingPairKey": {
      "type": "string",
      "unique": true,
      "private": true,
      "searchable": false
    },
    "conversation": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::conversation.conversation"
    },
    "respondedAt": {
      "type": "datetime"
    },
    "declinedAt": {
      "type": "datetime"
    }
  }
}
