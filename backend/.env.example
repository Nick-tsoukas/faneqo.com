HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Frontend origin used in fan magic-link emails (no trailing slash)
PUBLIC_APP_URL=http://localhost:3000

# Lane 1 transactional sender (fan magic-link). Never SHOW_MAIL_FROM.
EMAIL_DEFAULT_FROM=Faneqo <noreply@mail.faneqo.com>
EMAIL_DEFAULT_REPLY_TO=Faneqo <noreply@mail.faneqo.com>
RESEND_API_KEY=tobemodified

# Protected DM and gated-gallery media. Keep disabled until the configured S3
# bucket/prefix denies anonymous reads. Production never uses public fallback.
FANEQO_PROTECTED_MEDIA_ENABLED=false
AWS_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
# Optional; JWT_SECRET above is the signing-secret fallback.
FANEQO_PROTECTED_MEDIA_SECRET=
# Local development only; ignored when NODE_ENV=production.
FANEQO_DM_PUBLIC_MEDIA_FALLBACK=false

# Local repeated magic-link testing only. Ignored when NODE_ENV=production.
FAN_ACCOUNT_TEST_MODE=true
FAN_ACCOUNT_TEST_EMAIL_ALLOWLIST=you@example.com

# Local repeated email-campaign testing only. Ignored when NODE_ENV=production.
# Bypasses lastMessagedAt time cooldown (preview + create). Does not skip
# unsubscribe/bounce/complaint, overlapping queued/sending campaigns, or DMs.
FANEQO_CAMPAIGN_TEST_MODE=true
# Optional. If set, only these addresses skip the time cooldown.
# If empty, every fan skips the time cooldown in non-production test mode.
FANEQO_CAMPAIGN_TEST_EMAILS=you@example.com

# Production-only tightly scoped campaign testing. ALL three required.
# NODE_ENV=production is also required. Incomplete config fails closed
# (campaign preview/create return production_test_mode_misconfigured).
# Clamps Message Fans to the email allowlist; does not email the full list.
FANEQO_PROD_CAMPAIGN_TEST_MODE=false
FANEQO_PROD_CAMPAIGN_TEST_BAND_IDS=
FANEQO_PROD_CAMPAIGN_TEST_EMAILS=

# RockSnaps publishing. Positive integer band id. Unset or invalid disables the integration.
# Development uses the local SQLite band. Production must be Pat's verified band id, not the slug.
ROCKSNAPS_BAND_ID=
