# Copy to .env at the workspace root. Stackrun loads .env before stack.config.ts.
# Unprefixed keys = local development defaults.
# Production values stay on the Railway production service (no PRODUCTION_ block here).

# --- Tooling / Node pins (safe to commit defaults; not secrets) ---
# Local host: mise reads NODE_VERSION via mise.toml (development only).
# Staging Docker FE/BE (Task 3.6): stock image tags use the same vars —
#   image: node:${FRONTEND_NODE_VERSION:-${NODE_VERSION}}  (and BACKEND_*)
# Leave FRONTEND_/BACKEND_ empty to fall back to NODE_VERSION.
# Set separate pins when FE and BE need different Node majors (BE engines may cap at 20.x).
NODE_VERSION=22.11.0
FRONTEND_NODE_VERSION=
BACKEND_NODE_VERSION=

